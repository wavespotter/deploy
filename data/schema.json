{
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "profile": {
            "type": "string",
            "description": "AWS Credential Profile to use"
        },
        "name": {
            "type": "string",
            "description": "Use a given name instead of the repo name"
        },
        "region": {
            "type": "string",
            "description": "Set a region as default"
        },
        "role": {
            "type": "string",
            "description": "IAM Service Role ARN CloudFormation assumes for create/update/delete - supports {{accountId}}, {{partition}}, {{region}}, {{stack}}, {{project}}"
        },
        "artifacts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "docker": {
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        {
                            "type": "boolean",
                            "enum": [
                                false
                            ],
                            "description": "Disable the ECR image check"
                        }
                    ]
                },
                "s3": {
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        {
                            "type": "boolean",
                            "enum": [
                                false
                            ],
                            "description": "Disable the S3 artifact check"
                        }
                    ]
                }
            }
        },
        "tags": {
            "type": "array",
            "items": {
                "oneOf": [
                    {
                        "type": "string"
                    },
                    {
                        "type": "object",
                        "required": [
                            "Key",
                            "Value"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "Key": {
                                "type": "string"
                            },
                            "Value": {
                                "type": "string"
                            }
                        }
                    }
                ]
            }
        }
    }
}